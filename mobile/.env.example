# Copie para .env (o Expo carrega sozinho). Tudo é opcional.

# Endereço da API. Em desenvolvimento o app já tenta sozinho o host do Metro,
# 10.0.2.2 (emulador Android) e localhost na porta 4444. Preencha só se a API
# estiver em outro endereço/porta, por exemplo o IP da sua máquina na rede:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4444
EXPO_PUBLIC_API_URL=

# Push remoto (Expo Push). Sem o id do projeto EAS o app não registra token de
# push, e os lembretes locais continuam funcionando.
EXPO_PUBLIC_EAS_PROJECT_ID=
