# Modelo do .env. Copie para .env e ajuste. O .env nunca vai para o git.
# Os valores abaixo já funcionam com um PostgreSQL local (usuário/senha postgres).

PORT=4444
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=calendo
DB_USER=postgres
DB_PASSWORD=postgres
# Fuso usado pelo banco ("hoje", "esta semana") e pelos textos dos logs.
DB_TIMEZONE=America/Sao_Paulo

# Assinatura dos tokens JWT. Obrigatório em produção (a API não sobe sem ele
# com NODE_ENV=production). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O valor abaixo serve SÓ para rodar localmente.
JWT_SECRET=troque-este-segredo-local-de-desenvolvimento-0001

# Origens liberadas no CORS para clientes de navegador, separadas por vírgula.
# Vazio = qualquer origem.
CORS_ORIGINS=

# Nome exibido no remetente dos e-mails.
APP_NAME=Calendo

# SMTP opcional. Vazio = o código de recuperação de senha não sai da máquina e
# aparece no console da API (apenas fora de produção).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# IA opcional (OpenAI Responses API com saída estruturada). Sem a chave o
# assistente continua funcionando com o interpretador local em português.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
